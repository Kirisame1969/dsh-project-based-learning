{
  "name": "dsh-project-based-learning",
  "version": "3.0.0",
  "description": "项目制教学教练：以真实项目为主线，先教学后实践，用可运行示例与就地解释推进，并按实践证据调整支架。教学法与学科分离，领域导航可选（随包提供 Unity Shader / Unity C#）。以 DSH 技能与组合包双形态分发。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "bin": {
    "coach-validate": "./skills/dsh-project-based-learning/scripts/validate-learning-state.mjs",
    "coach-migrate": "./skills/dsh-project-based-learning/scripts/migrate-v1-state.mjs"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "skills",
    "LICENSE",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md"
  ],
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "cordis",
    "agent-skill",
    "skill",
    "project-based-learning",
    "ai-tutor",
    "teaching",
    "unity",
    "csharp"
  ],
  "license": "MIT",
  "author": "Kirisame1969",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kirisame1969/dsh-project-based-learning.git"
  },
  "homepage": "https://github.com/Kirisame1969/dsh-project-based-learning#readme",
  "bugs": {
    "url": "https://github.com/Kirisame1969/dsh-project-based-learning/issues"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "packageManager": "pnpm@11.7.0",
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh": ">=0.1.2-rc.1 <0.3.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh": {
      "optional": true
    }
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "smoke": "node test/entry.smoke.mjs",
    "validate": "node skills/dsh-project-based-learning/scripts/validate-learning-state.mjs --state skills/dsh-project-based-learning/assets/state.template.json"
  }
}
